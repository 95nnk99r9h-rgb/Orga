rules_version = '2';

// Fundort – security rules for the online sync (see docs/ONLINE.md).
// Everyone signs in with e-mail and password (devices set up earlier may
// still use an anonymous account). A household can only be read and
// written by accounts listed in its `members`; an account joins by knowing
// the household's code (the document id), which adds only itself. An
// account can look up the households it belongs to, but no others, so
// codes can't be found.
service cloud.firestore {
  match /databases/{database}/documents {
    match /households/{code} {
      function signedIn() {
        return request.auth != null;
      }
      function member() {
        return signedIn() && request.auth.uid in resource.data.members;
      }
      function joining() {
        let added = request.resource.data.members.removeAll(resource.data.members);
        return signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && added.hasOnly([request.auth.uid]);
      }

      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow update: if member() || joining();
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow delete: if false;

      match /{document=**} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/households/$(code)).data.members;
      }
    }
  }
}
